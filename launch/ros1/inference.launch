<!--
  ROS 1 launch file for the inference node.

  Usage:
    roslaunch ros_dl_inference inference.launch config:=/path/to/config.yaml
-->
<launch>
  <arg name="config"  default="$(find ros_dl_inference)/config/example_pytorch.yaml"/>
  <arg name="log_level" default="info"/>

  <node
    pkg="ros_dl_inference"
    type="inference_node_ros1"
    name="rl_inference"
    args="--config $(arg config)"
    output="screen"
    respawn="true"
    respawn_delay="2"
  />
</launch>
